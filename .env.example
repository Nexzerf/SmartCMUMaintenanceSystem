# Postgres connection string.
# Supabase: Connect -> "Transaction pooler" (port 6543) for the deployed app.
# Local (npm run db:local): postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Use 1 with the local PGlite server; leave empty for Supabase.
DATABASE_POOL_MAX=1

# Secret used to sign the session cookie (at least 32 random characters)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Supabase (Storage + Realtime). Leave empty to use local disk uploads and 4-second polling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=request-images

# Local seeding only: password given to every seeded demo account (a random one is printed if empty).
SEED_PASSWORD=
