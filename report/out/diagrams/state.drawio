JECT : ปฏิเสธ\nASG --&gt; REJECT : ปฏิเสธ\nCLOSED --&gt; [*]\nCANCEL --&gt; [*]\nREJECT --&gt; [*]\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="2"><mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="771" height="1527" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram></mxfile>