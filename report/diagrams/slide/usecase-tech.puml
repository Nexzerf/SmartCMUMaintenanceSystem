@startuml usecase-tech
' มุมมองช่าง แยกจากแผนภาพยูสเคสฉบับเต็ม (01-usecase.puml) ให้อ่านได้บนสไลด์
!pragma layout smetana
!include ../_style.iuml
left to right direction
skinparam packageStyle rectangle

actor "ช่าง" as Tech

rectangle "มุมมองช่าง" {
  usecase "UC01 เข้าสู่ระบบ" as UC01
  usecase "UC13 ดูการแจ้งเตือน" as UC13
  usecase "UC14 ดูงานที่ได้รับมอบหมาย" as UC14
  usecase "UC15 รับงาน" as UC15
  usecase "UC16 แจ้งรออะไหล่" as UC16
  usecase "UC17 บันทึกผลการซ่อม" as UC17
  usecase "UC18 แนบรูปหลังซ่อม" as UC18
}

Tech --> UC01
Tech --> UC13
Tech --> UC14
Tech --> UC15
Tech --> UC16
Tech --> UC17
UC17 ..> UC18 : <<include>>
@enduml
